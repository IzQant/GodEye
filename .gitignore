__pycache__/
*.pyc
.venv/
venv/
.env

# 생성/수집 데이터는 git에 넣지 않는다 (재생성 가능, 용량 큼)
# 주의: data/images/*.png 는 하위폴더를 못 거른다 → ** 로 지정
data/raw/*.json
data/images/**/*.png
data/images/**/*.jpg
data/images/**/*.jpeg
# 참조 맵은 특징점 정렬의 '런타임 의존성'이라 배포에 포함한다
# (개인 학습용 사용 — data/maps/README.md 참고)
!data/maps/*.png

*.joblib
.pytest_cache/
.DS_Store
